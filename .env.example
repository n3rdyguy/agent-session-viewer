# Agent Session Viewer - optional env overrides
# Copy to .env if useful. The app loads it from the current working directory.
# Variables already set by your shell or IDE take precedence over this file.
# ~ expands to your home directory on all platforms.
#
# Start the server with:  uv run agent-session-viewer

# Flask debug / reloader (off by default). Truthy: 1, true, yes, on
# ASV_DEBUG=1

# Log session discovery and session-loading durations (off by default).
# This is independent of ASV_DEBUG. Truthy: 1, true, yes, on
# ASV_TIMING_DEBUG=1

# Agent homes (defaults shown). Sessions/projects live under these roots.
# GROK_HOME=~/.grok
# CLAUDE_HOME=~/.claude
# CODEX_HOME=~/.codex
